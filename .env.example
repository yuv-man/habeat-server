# MongoDB Configuration
# The server reads MONGO_URL_PROD, then MONGO_URL, then MONGODB_URI (app.module.ts).
# Any other name (MONGO_URL_LOCAL etc.) is ignored.
# The dockerised mongo runs with --auth, so a local URL MUST carry credentials
# and authSource=admin — without them every query fails with
# "Command find requires authentication".
MONGO_URL=mongodb://root:rootpassword@localhost:27017/?authSource=admin
# Atlas / production instead:
# MONGO_URL_PROD=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Server Configuration
PORT=5080
NODE_ENV=development
NODE_DEBUG_LOG=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_here

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Client URLs
DEV_CLIENT_SITE=http://localhost:8080
PROD_CLIENT_SITE=https://your-app.vercel.app

# USDA API
USDA_API_KEY=your_usda_api_key

# Test Mode Configuration
TEST_MODE=false
# TEST_USER_ID=your-user-id-here

# Admin user (full premium access for local/dev testing)
# Comma-separated emails promoted to admin on login
ADMIN_USER_EMAILS=your-email@example.com
# Or match by MongoDB user id
# ADMIN_USER_ID=your-user-id-here

# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Get webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# AI Agent Testing (see AI_AGENT_TESTING.md)
# URL of the Habeat frontend the browser agent navigates
HABEAT_URL=http://localhost:8080
# Model used for the agent's decisions and the UX analysis
AI_AGENT_MODEL=gemini-2.5-flash
# Open a visible browser so you can watch the session
AI_AGENT_HEADFUL=false
# Milliseconds of delay per Playwright action — only useful when headful
AI_AGENT_SLOWMO=0
